      {
        "title": {
          "en": "Set the measured room humidity"
        },
        "titleFormatted": {
          "en": "Set the measured room humidity to [[humidity]] %"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=heatpump"
          },
          {
            "name": "humidity",
            "type": "number",
            "min": 0,
            "max": 100,
            "step": 0.1
          }
        ],
        "id": "set_room_humidity"
      },
      {
        "title": {
          "en": "Set the measured room temperature"
        },
        "titleFormatted": {
          "en": "Set the measured room temperature to [[temperature]] °C"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=heatpump"
          },
          {
            "name": "temperature",
            "type": "number",
            "min": -50,
            "max": 100,
            "step": 0.1
          }
        ],
        "id": "set_room_temperature"
      }
    ]
  },
