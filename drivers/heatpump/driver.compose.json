{
  "name": { "en": "Panasonic JKE" },
  "class": "airconditioning",
  "capabilities": ["onoff", "measure_temperature", "target_temperature", "pana_mode", "pana_fan"],
  "capabilitiesOptions": {
    "target_temperature": {
      "min": 16,
      "max": 30,
      "step": 1,
      "units": { "en": "°C" }
    },
    "measure_temperature": {
      "title": { "en": "Room temperature" }
    }
  },
  "platforms": ["local"],
  "images": {
    "small": "/drivers/heatpump/assets/images/small.png",
    "large": "/drivers/heatpump/assets/images/large.png",
    "xlarge": "/drivers/heatpump/assets/images/xlarge.png"
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": { "next": "add_devices" }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": { "en": "Broadlink RM4" },
      "children": [
        {
          "id": "rm4_ip",
          "type": "text",
          "label": { "en": "RM4 IP address" },
          "value": "",
          "hint": { "en": "Local IP address of the Broadlink RM4 that controls this heat pump, e.g. 10.47.102.129" }
        }
      ]
    }
  ]
}